generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Catalogo {
  id          Int     @id @default(autoincrement())
  name        String
  price       Float
  description String
  duration    Int
  agendamentos Agendamentos[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String
  password  String
  role      String     @default("USER")
}

model Agendamentos {
  id             Int      @id @default(autoincrement())
  date           DateTime
  cliente        String
  phone          String?
  catalogoId     Int
  catalogo       Catalogo @relation(fields: [catalogoId], references: [id])
  customDuration Int?     
  status         String   @default("SOLICITADO")
  createdAt      DateTime @default(now())
}
