generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Catalogo {
  id          Int     @id @default(autoincrement())
  name        String
  price       Float
  description String
  duration    Int
  agendamentos Agendamentos[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String
  password  String
  role      String     @default("USER")
  agendamentos Agendamentos[]
}

model Agendamentos{
   id          Int      @id @default(autoincrement())
   date        DateTime
   userId      Int
   catalogoId  Int
   user        User     @relation(fields: [userId], references: [id])
   catalogo    Catalogo  @relation(fields: [catalogoId], references: [id])
   status      String   @default("SOLICITADO")
}
